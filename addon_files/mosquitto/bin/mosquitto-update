#!/bin/sh
#
#   Self-update worker (ROADMAP task 5), the RedMatic worker without the
#   progress model - the packages are a few MB and install in seconds.
#
#   Started detached by www/update.cgi; reports through a JSON state file
#   that the settings page polls (www/js/script.js):
#
#     {"phase": "...", "message": "...", "version": "2.1.2+1",
#      "installed": "2.1.2+0", "error": "", "reboot": 0|1,
#      "elapsed": seconds, "ts": epoch}
#
#   Phases: starting resolve preflight download verify install start done error
#
#   Usage: mosquitto-update [--force] [version]
#
#   Without a version the newest GitHub release is installed. --force skips
#   the "must be newer than the installed version" check (tests, re-installs).
#   MOSQUITTO_UPDATE_BASE_URL overrides the download location for tests: a
#   directory that holds the package and its .sha256 file.
#
#   The install replaces the addon tree (this script included), so the worker
#   copies itself to the state directory on tmpfs and runs from there.
#

ADDON_DIR=/usr/local/addons/mosquitto
CONF_DIR=/usr/local/etc/config
STATE_DIR=/tmp/mosquitto-update
STATE=$STATE_DIR/state.json
LOG=$STATE_DIR/update.log
INSTALL_LOG=$STATE_DIR/install.log
ARCHIVE=/usr/local/tmp/new_addon.tar.gz
API_URL=https://api.github.com/repos/homematic-community/ccu-addon-mosquitto/releases/latest
RELEASES_URL=https://github.com/homematic-community/ccu-addon-mosquitto/releases/download

export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export HOME=/root

case "$0" in
    $STATE_DIR/*) ;;
    *)
        mkdir -p $STATE_DIR
        cp "$0" $STATE_DIR/worker.sh || exit 1
        exec /bin/sh $STATE_DIR/worker.sh "$@"
        ;;
esac

FORCE=0
VERSION=""
for arg in "$@"; do
    case $arg in
        --force) FORCE=1 ;;
        -*) echo "usage: mosquitto-update [--force] [version]" >&2; exit 1 ;;
        *) VERSION=$arg ;;
    esac
done

T0=`date +%s`

# --- state file --------------------------------------------------------------

PHASE=starting
MESSAGE=""
INSTALLED=""
ERROR=""
REBOOT=0

elapsed() {
    echo $((`date +%s` - T0))
}

json_escape() {
    printf '%s' "$1" | tr -d '\r' | tr '\n' ' ' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

write_state() {
    printf '{"phase":"%s","message":"%s","version":"%s","installed":"%s","error":"%s","reboot":%s,"elapsed":%s,"ts":%s}\n' \
        "$PHASE" "`json_escape "$MESSAGE"`" "$VERSION" "$INSTALLED" "`json_escape "$ERROR"`" \
        "$REBOOT" "`elapsed`" "`date +%s`" > $STATE.tmp
    mv $STATE.tmp $STATE
}

set_state() {
    PHASE=$1
    MESSAGE=$2
    write_state
    log "$PHASE: $MESSAGE"
}

log() {
    echo "`date '+%H:%M:%S'` +`elapsed`s $*" >> $LOG
    if command -v logger >/dev/null 2>&1; then
        logger -t mosquitto -p daemon.info "update: $*"
    fi
}

fail() {
    ERROR=$1
    MESSAGE=$1
    PHASE=error
    write_state
    log "error: $1"
    rm -f $ARCHIVE.part
    rm -f $STATE_DIR/pid
    exit 1
}

# --- lock --------------------------------------------------------------------

mkdir -p $STATE_DIR
if [ -f $STATE_DIR/pid ]; then
    OLD_PID=`cat $STATE_DIR/pid`
    if [ -n "$OLD_PID" ] && [ "$OLD_PID" != "$$" ] && kill -0 $OLD_PID 2>/dev/null; then
        echo "an update is already running (pid $OLD_PID)" >&2
        exit 2
    fi
fi
echo $$ > $STATE_DIR/pid
: > $LOG
: > $INSTALL_LOG

# --- helpers -----------------------------------------------------------------

# vercmp A B: prints 1 if A is newer than B, 0 if equal, -1 if older.
# Versions are <mosquitto x.y.z>+<addon build>: 2.1.2+1 > 2.1.2+0 > 1.5.8+4.
vercmp() {
    a=${1%%+*}
    b=${2%%+*}
    abuild=${1#"$a"}
    bbuild=${2#"$b"}
    abuild=${abuild#+}
    bbuild=${bbuild#+}
    i=1
    while [ $i -le 3 ]; do
        x=`echo "$a" | cut -d. -f$i`
        y=`echo "$b" | cut -d. -f$i`
        x=${x:-0}
        y=${y:-0}
        if [ "$x" -gt "$y" ] 2>/dev/null; then echo 1; return; fi
        if [ "$x" -lt "$y" ] 2>/dev/null; then echo -1; return; fi
        i=$((i + 1))
    done
    abuild=${abuild:-0}
    bbuild=${bbuild:-0}
    if [ "$abuild" -gt "$bbuild" ] 2>/dev/null; then echo 1; return; fi
    if [ "$abuild" -lt "$bbuild" ] 2>/dev/null; then echo -1; return; fi
    echo 0
}

# "+" in a URL path must be encoded, GitHub does the same for its links
urlenc() {
    echo "$1" | sed 's/+/%2B/g'
}

broker_running() {
    $CONF_DIR/rc.d/mosquitto status >/dev/null 2>&1
}

installer_running() {
    ps -o pid,comm,args 2>/dev/null | grep -v grep | grep -q "install_addon\|update_script"
}

# directories the installer created below /usr/local/tmp since we started
new_tmp_dirs() {
    for d in /usr/local/tmp/tmp.*; do
        [ -d "$d" ] || continue
        case " $TMP_BEFORE " in
            *" $d "*) ;;
            *) echo "$d" ;;
        esac
    done
}

# --- resolve -----------------------------------------------------------------

. $ADDON_DIR/versions
INSTALLED=$VERSION_ADDON

if [ -z "$VERSION" ]; then
    set_state resolve "Suche nach der neuesten Version ..."
    VERSION=`curl -fsSL --max-time 30 $API_URL 2>>$LOG | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1`
    [ -n "$VERSION" ] || fail "Die neueste Version konnte nicht ermittelt werden (GitHub nicht erreichbar?)"
fi
write_state

if [ $FORCE -eq 0 ] && [ "`vercmp "$VERSION" "$INSTALLED"`" != "1" ]; then
    fail "Version $VERSION ist nicht neuer als die installierte Version $INSTALLED"
fi

ARCH=`uname -m`
case $ARCH in
    armv7l) FILE=mosquitto-$VERSION.tar.gz ;;
    x86_64|aarch64) FILE=mosquitto-$ARCH-$VERSION.tar.gz ;;
    *) fail "Nicht unterstützte Architektur: $ARCH" ;;
esac
if [ -n "$MOSQUITTO_UPDATE_BASE_URL" ]; then
    URL=$MOSQUITTO_UPDATE_BASE_URL/`urlenc "$FILE"`
else
    URL=$RELEASES_URL/`urlenc "$VERSION"`/`urlenc "$FILE"`
fi

# --- preflight ---------------------------------------------------------------

set_state preflight "Prüfe Voraussetzungen ..."

# The original CCU3 firmware installs through a chroot that copies parts of
# the root filesystem next to the unpacked package (measured at ~230 MB by
# RedMatic); OpenCCU unpacks only. The CCU3's /usr/local has few inodes.
if [ -f /etc/init.d/S00InstallAddon ]; then
    NEED_KB=307200
    NEED_INODES=20000
else
    NEED_KB=51200
    NEED_INODES=2000
fi

# Leftovers of an earlier installation attempt eat the space and inodes the
# update needs. Release stale mounts and remove them; a dir that stays
# mounted blocks the update - deleting through a bind mount of /usr/local
# would be fatal.
if ! installer_running; then
    for d in /usr/local/tmp/tmp.*; do
        [ -d "$d" ] || continue
        for m in usr/local dev/pts sys proc dev; do
            if grep -q " $d/$m " /proc/mounts 2>/dev/null; then
                umount "$d/$m" 2>>$LOG && log "released stale mount $d/$m"
            fi
        done
        if grep -q " $d/" /proc/mounts 2>/dev/null; then
            fail "Altes Installationsverzeichnis $d hat noch eingehängte Dateisysteme und kann nicht entfernt werden - bitte die Zentrale neu starten"
        fi
        rm -rf "$d" && log "removed stale $d"
    done
    if [ -f $ARCHIVE ]; then
        rm -f $ARCHIVE && log "removed stale $ARCHIVE"
    fi
elif [ -f $ARCHIVE ] || [ -n "`ls -d /usr/local/tmp/tmp.* 2>/dev/null`" ]; then
    fail "Es läuft gerade eine andere Installation (install_addon)"
fi

mkdir -p /usr/local/tmp
for where in /usr/local/tmp /usr/local/addons; do
    FREE_KB=`df -Pk $where 2>/dev/null | awk 'NR == 2 {print $4}'`
    if [ -z "$FREE_KB" ] || [ "$FREE_KB" -lt $NEED_KB ]; then
        fail "Nicht genug freier Speicher auf $where: $((${FREE_KB:-0} / 1024)) MB frei, mindestens $((NEED_KB / 1024)) MB werden benötigt"
    fi
    FREE_INODES=`df -Pi $where 2>/dev/null | awk 'NR == 2 {print $4}'`
    if [ -n "$FREE_INODES" ] && [ "$FREE_INODES" -gt 0 ] 2>/dev/null && [ "$FREE_INODES" -lt $NEED_INODES ]; then
        fail "Nicht genug freie Datei-Einträge (Inodes) auf $where: $FREE_INODES frei, mindestens $NEED_INODES werden benötigt"
    fi
done
log "installed $INSTALLED, target $VERSION, arch $ARCH, free $((FREE_KB / 1024)) MB / ${FREE_INODES:-?} inodes, url $URL"

# --- download ----------------------------------------------------------------

set_state download "Lade $FILE herunter ..."

SHA=`curl -fsSL --max-time 30 "$URL.sha256" 2>>$LOG | awk '{print $1}'`
[ -n "$SHA" ] || fail "Die Prüfsumme für $FILE konnte nicht geladen werden ($URL.sha256)"

rm -f $ARCHIVE.part
curl -fsSL --max-time 600 -o $ARCHIVE.part "$URL" 2>>$LOG || fail "Download fehlgeschlagen: $URL"
BYTES=`stat -c %s $ARCHIVE.part 2>/dev/null`
[ "${BYTES:-0}" -gt 0 ] || fail "Download fehlgeschlagen: leere Datei"
log "downloaded $BYTES bytes"

# --- verify ------------------------------------------------------------------

set_state verify "Prüfe Prüfsumme ..."
ACTUAL=`sha256sum $ARCHIVE.part | awk '{print $1}'`
if [ "$ACTUAL" != "$SHA" ]; then
    fail "Prüfsumme stimmt nicht (erwartet $SHA, erhalten $ACTUAL)"
fi
mv $ARCHIVE.part $ARCHIVE
log "sha256 ok"

# --- install -----------------------------------------------------------------

TMP_BEFORE=`ls -d /usr/local/tmp/tmp.* 2>/dev/null | tr '\n' ' '`
set_state install "Installiere ccu-addon-mosquitto $VERSION ..."

if [ -x /bin/install_addon ]; then
    # what the CCU WebUI does under Zusatzsoftware. Exit codes: 0 installed,
    # 10 reboot required, OpenCCU 101-106 for archive/checksum problems.
    /bin/install_addon >> $INSTALL_LOG 2>&1
    RC=$?
else
    # no firmware installer (debmatic, containers): the same steps by hand
    (
        dir=`mktemp -d -p /usr/local/tmp` || exit 102
        echo "Extracting addon..."
        tar -C "$dir" --no-same-owner --no-same-permissions -xf $ARCHIVE || exit 102
        rm -f $ARCHIVE
        [ -x "$dir/update_script" ] || exit 104
        echo "Executing update_script..."
        cd "$dir" && ./update_script HM-RASPBERRYMATIC
        rc=$?
        cd /
        rm -rf "$dir"
        exit $rc
    ) >> $INSTALL_LOG 2>&1
    RC=$?
fi
log "installer exit code $RC"
cat $INSTALL_LOG >> $LOG

# The CCU3 firmware's install_addon leaves its temp dir behind. Never remove
# a dir that still has something mounted below it.
for d in `new_tmp_dirs`; do
    if grep -q " $d/" /proc/mounts 2>/dev/null; then
        log "warning: $d still has mounts, not removed"
    else
        rm -rf "$d"
        log "removed $d"
    fi
done
rm -f $ARCHIVE

case $RC in
    0) ;;
    10) REBOOT=1 ;;
    *) fail "Installation fehlgeschlagen (Code $RC), Details im Update-Log" ;;
esac

. $ADDON_DIR/versions
INSTALLED=$VERSION_ADDON
if [ "$INSTALLED" != "$VERSION" ]; then
    fail "Nach der Installation ist Version $INSTALLED aktiv, erwartet war $VERSION"
fi

# --- start -------------------------------------------------------------------

if [ $REBOOT -eq 1 ]; then
    set_state done "ccu-addon-mosquitto $VERSION installiert. Die Zentrale muss neu gestartet werden."
    rm -f $STATE_DIR/pid
    exit 0
fi

set_state start "Starte Mosquitto ..."
if ! broker_running; then
    # On the CCU3 firmware update_script does not start the service (it
    # cannot tell a live run from the chroot at shutdown), on OpenCCU it
    # already did.
    (cd / && $CONF_DIR/rc.d/mosquitto start) >> $LOG 2>&1
fi
i=0
UP=0
while [ $i -lt 30 ]; do
    if broker_running; then
        UP=1
        break
    fi
    sleep 1
    i=$((i + 1))
done
log "start finished (running: $UP), total `elapsed` s"
if [ $UP -eq 0 ]; then
    set_state done "ccu-addon-mosquitto $VERSION installiert. Mosquitto läuft noch nicht - bitte den Prozessstatus und das Log prüfen."
else
    set_state done "ccu-addon-mosquitto $VERSION installiert, Mosquitto läuft."
fi
rm -f $STATE_DIR/pid
exit 0
