{
  "name": "ccu-addon-mosquitto",
  "version": "2.1.2+0",
  "description": "Mosquitto MQTT broker packaged as Homematic CCU addon",
  "repository": "github:homematic-community/ccu-addon-mosquitto",
  "private": true,
  "main": "none",
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "license": "(EPL-1.0 OR EDL-1.0)",
  "scripts": {
    "build": "./build.sh",
    "build:armv7l": "./build_addon.sh armv7l",
    "build:aarch64": "./build_addon.sh aarch64",
    "build:x86_64": "./build_addon.sh x86_64",
    "update:versions": "node update_versions.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:webui",
    "test:unit": "node --test test/parser.test.js",
    "test:e2e": "node --test --test-timeout=300000 test/e2e.test.js",
    "test:webui": "node --test --test-timeout=600000 test/webui.test.js"
  },
  "devDependencies": {
    "mqtt": "^5.15.2",
    "playwright": "^1.63.0"
  }
}
